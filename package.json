{
  "name": "stand-for-planet-earth-web",
  "version": "0.1.0",
  "private": true,
  "description": "Remake web du jeu GameMaker « Stand For Planet Earth »",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node tools/build.ts --watch --serve",
    "build": "node tools/build.ts",
    "start": "node tools/build.ts && node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "convert-rooms": "node tools/convert-rooms.ts",
    "extract-assets": "node tools/extract-assets.ts",
    "make-sprites": "node tools/make-sprites.ts",
    "level-map": "node tools/level-map.ts rm_world2 rm_world2_1",
    "make-studio": "node tools/make-studio.ts",
    "make-pickups": "node tools/make-pickups.ts"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
